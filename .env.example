AZURE_OPENAI_API_LLM_KEY=your_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment
AZURE_OPENAI_API_VERSION=2025-03-01-preview

AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_API_VERSION=2025-03-01-preview

EMAIL=you@example.com
NCBI_API_KEY=your_ncbi_api_key

CLAUDE_ENDPOINT=https://your-resource-name.services.ai.azure.com/anthropic/

# Optional: override local RAG assets (download from Zenodo)
