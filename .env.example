# DRUGAGENT_RAG_INDEX_PATH=/path/to/data/kinase_rag_index.faiss
# DRUGAGENT_RAG_META_PATH=/path/to/data/kinase_rag_metadata.json
# DRUGAGENT_RAG_RESULTS_JSONL=/path/to/rag_results_v2.jsonl
# DRUGAGENT_RAG_GDRIVE_URL=https://drive.google.com/drive/folders/1w_QxsiG-Ee9y25JsH7iYxGVdT9G8ybvZ?usp=sharing
